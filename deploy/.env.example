# Gateway configuration for docker-compose (single-port setup).
#
# Beacon runs everything behind an nginx gateway on ONE host port. Postgres and
# Redis are also published for local debugging; change any that collide.
#
# Usage: copy to `.env` in the directory you run compose from, or pass inline:
#   BEACON_GATEWAY_PORT=9000 make up

BEACON_GATEWAY_PORT=8090
BEACON_POSTGRES_PORT=5432
BEACON_REDIS_PORT=6379

# ---------------------------------------------------------------------------
# AI alert enrichment (optional). When enabled, firing alerts are triaged by an
# Ollama-compatible model (assessed impact + likely cause + suggested fix) before
# being delivered. Best-effort: if the model is slow/down the alert still ships.
# ---------------------------------------------------------------------------
BEACON_AI_ENABLED=false
BEACON_AI_BASE_URL=https://ollama.example.com   # endpoint root, no trailing slash, no /api
BEACON_AI_MODEL=                                # a model installed on that endpoint, e.g. llama3.1
BEACON_AI_API_KEY=                              # x-api-key if the endpoint requires one
BEACON_AI_TIMEOUT=20s                           # per-alert budget for the model call

# --- Notification webhook SSRF guard (advanced) ---
# Slack/webhook channels fetch a tenant-supplied URL. By default that URL must be
# https and must NOT resolve to a private/loopback/link-local address (blocks SSRF
# to cloud metadata, internal services, etc). These re-open that hole and are for
# single-tenant on-prem operators ONLY — never enable in a multi-tenant deployment.
# BEACON_WEBHOOK_ALLOW_PRIVATE=false
# BEACON_WEBHOOK_ALLOW_HTTP=false

# --- Sign in with Google (optional) ---
# The OAuth 2.0 Client ID for "Continue with Google". Empty = the feature is off and
# the button is hidden. One value drives both the backend (accepts ID tokens for this
# audience) and the frontend (renders the button — baked into the bundle at build).
# Set up: Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client
# ID -> "Web application", and add your origin as an Authorized JavaScript origin
# (for local dev: http://localhost:8090). No client secret is needed. Then `make up`.
BEACON_GOOGLE_CLIENT_ID=

# ── "Continue with OpsAPI" (generic OIDC single sign-on) ──────────────────────
# Log users in via the standard OAuth 2.0 Authorization-Code (+ PKCE) flow against
# ANY OpenID/OAuth2 provider (OpsAPI, Keycloak, Auth0…). All five of the client
# id/secret + three URLs must be set to enable it; empty = feature off, button
# hidden. Beacon is a confidential client and reads identity from the provider's
# UserInfo endpoint (no ID-token/JWKS verification required).
#
# Register beacon as a client in OpsAPI, with redirect_uri = BEACON_OIDC_REDIRECT_URL:
#   docker exec opsapi lapis exec "require('scripts.oauth-register-client').run({ \
#     client_id='beacon', name='Beacon', \
#     redirect_uris={'https://<beacon-api-host>/api/v1/auth/oidc/callback'}, \
#     scopes={'openid','profile','email','offline_access'} })"
# Store the printed client_secret in BEACON_OIDC_CLIENT_SECRET.
BEACON_OIDC_PROVIDER=OpsAPI
BEACON_OIDC_CLIENT_ID=
BEACON_OIDC_CLIENT_SECRET=
BEACON_OIDC_AUTHORIZE_URL=https://<opsapi-host>/oauth/authorize
BEACON_OIDC_TOKEN_URL=https://<opsapi-host>/oauth/token
BEACON_OIDC_USERINFO_URL=https://<opsapi-host>/oauth/userinfo
# Beacon's own callback (must exactly match a registered redirect_uri above).
BEACON_OIDC_REDIRECT_URL=https://<beacon-api-host>/api/v1/auth/oidc/callback
# The frontend page the callback hands the session to (tokens via URL fragment).
BEACON_OIDC_POST_LOGIN_URL=https://<beacon-frontend-host>/login/callback
# Space/comma-separated; must include openid. Default: openid,profile,email
BEACON_OIDC_SCOPES=openid,profile,email,offline_access

# Frontend (baked into the bundle at build): show the OpsAPI button + its label.
NEXT_PUBLIC_OIDC_ENABLED=true
NEXT_PUBLIC_OIDC_PROVIDER=OpsAPI
