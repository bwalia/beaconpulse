# Fastfile — SysOps 24/7 native iOS release (GitHub Actions + Vault + fastlane).
#
# CI signs with an App Store Connect API key pulled from Vault by
# ci/load-ios-vault-secrets.sh. Ported from the Ring Promoter pipeline
# (ring-promoter/ios/fastlane/Fastfile); the differences are that this project
# is generated by XcodeGen (the workflow runs `xcodegen generate` and flips
# aps-environment to production before any lane runs) and there is no widget.
# See .github/workflows/ios-release.yml.

default_platform(:ios)

APP_ID = "com.sysops247.app".freeze
XCODEPROJ = "Beacon.xcodeproj".freeze
SCHEME = "SysOps".freeze
IPA_NAME = "SysOps.ipa".freeze

def team_id
  ENV.fetch("APPLE_TEAM_ID") do
    UI.user_error!("APPLE_TEAM_ID is not set — add it to Vault secret/beaconpulse/ios")
  end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
    in_house: false
  )
end

# Beacon.xcodeproj is git-ignored (XcodeGen output) — every lane needs the
# workflow's "Generate Xcode project" step to have run first.
def assert_generated_project!
  UI.user_error!(
    "#{XCODEPROJ} not found — run `xcodegen generate` before the fastlane lanes"
  ) unless File.exist?(File.expand_path("../#{XCODEPROJ}", __dir__))
end

# The entitlements request push + Sign in with Apple. Fail fast when a freshly
# downloaded profile is missing either capability — otherwise codesign fails
# later with a far worse error, or the IPA uploads and is rejected.
def assert_profile_entitlements!(profile_path)
  require "shellwords"
  UI.user_error!("Missing provisioning profile path") if profile_path.to_s.empty?
  xml = `security cms -D -i #{Shellwords.escape(profile_path)} 2>/dev/null`
  UI.user_error!("Could not decode provisioning profile at #{profile_path}") if xml.empty?
  { "aps-environment" => "Push Notifications",
    "com.apple.developer.applesignin" => "Sign in with Apple" }.each do |ent, label|
    unless xml.include?(ent)
      UI.user_error!(
        "Profile at #{profile_path} lacks #{ent} — enable the #{label} " \
        "capability on #{APP_ID} in the Developer Portal, then re-run."
      )
    end
  end
  UI.success("Profile carries push + Sign in with Apple entitlements")
end

def emit_github(file_env_var, line)
  path = ENV[file_env_var]
  File.write(path, "#{line}\n", mode: "a") if path && !path.empty?
end

# Deterministic IPA location, anchored to this file rather than Dir.pwd, so the
# build lane and the upload lanes (separate fastlane processes with different
# working directories) always agree on the path.
def ipa_output_dir
  File.expand_path("../build", __dir__)
end

def ipa_output_path
  File.join(ipa_output_dir, IPA_NAME)
end

def write_export_options(path, profile_name)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>teamID</key>
    \t<string>#{team_id}</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>compileBitcode</key>
    \t<false/>
    \t<key>stripSwiftSymbols</key>
    \t<true/>
    \t<key>manageAppVersionAndBuildNumber</key>
    \t<false/>
    \t<key>provisioningProfiles</key>
    \t<dict>
    \t\t<key>#{APP_ID}</key>
    \t\t<string>#{profile_name}</string>
    \t</dict>
    </dict>
    </plist>
  PLIST
end

platform :ios do
  desc "Run unit tests on the simulator"
  lane :test do
    assert_generated_project!
    run_tests(
      project: XCODEPROJ,
      scheme: SCHEME,
      devices: ["iPhone 17"],
      clean: true
    )
  end

  desc "Print next TestFlight build number for VERSION_NAME to GITHUB_OUTPUT"
  lane :ci_build_number do
    version = ENV.fetch("VERSION_NAME")
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0
    )
    nxt = latest.to_i + 1
    UI.message("Latest TestFlight build for #{version} is #{latest}; next is #{nxt}")
    emit_github("GITHUB_OUTPUT", "build_number=#{nxt}")
  end

  desc "Provision code signing from the ASC API key into a persistent keychain"
  lane :prepare_signing do
    assert_generated_project!
    api_key = asc_api_key
    kc_path = ENV.fetch("BUILD_KEYCHAIN_PATH")
    kc_pass = ENV.fetch("BUILD_KEYCHAIN_PASSWORD")
    tmp_dir = ENV["RUNNER_TEMP"] || Dir.pwd

    # The keychain persists across runs on the self-hosted runner so `cert` reuses
    # the same Apple Distribution certificate instead of minting a new one every
    # build (Apple caps distribution certs). Create it on first use, unlock after.
    if File.exist?(kc_path)
      unlock_keychain(path: kc_path, password: kc_pass, set_default: false)
    else
      create_keychain(
        path: kc_path,
        password: kc_pass,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        add_to_search_list: true
      )
    end
    # Keep the keychain on the codesign search list regardless of which branch ran.
    sh("security", "list-keychains", "-d", "user", "-s", kc_path,
       File.expand_path("~/Library/Keychains/login.keychain-db"))
    # Disable the auto-lock timeout so the keychain stays unlocked between the
    # prepare_signing and build_ipa steps (separate fastlane processes).
    sh("security", "set-keychain-settings", kc_path)

    # Create (first run) or reuse (later runs) the distribution certificate from
    # the ASC API key. No certificate private key is stored in Vault.
    cert(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: kc_pass,
      output_path: tmp_dir
    )

    # `force` regenerates the profile so it picks up current App ID capabilities;
    # it conflicts with `readonly` — use force alone.
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, force: true)
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    assert_profile_entitlements!(profile_path)
    emit_github("GITHUB_ENV", "INSTALLED_PROFILE_PATH=#{profile_path}") if profile_path

    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      targets: [SCHEME]
    )

    out = ENV.fetch("EXPORT_OPTIONS_PLIST", File.join(tmp_dir, "ExportOptions.plist"))
    write_export_options(out, profile_name)
    UI.success("Signing ready — ExportOptions at #{out}")
  end

  desc "Archive and export a signed App Store IPA"
  lane :build_ipa do
    assert_generated_project!
    # Version and build number ride in as build settings: the XcodeGen project
    # doesn't use apple-generic versioning, so agvtool-based increments no-op.
    xcargs = ["CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}"]
    version = ENV["VERSION_NAME"]
    xcargs << "MARKETING_VERSION=#{version}" if version && !version.empty?

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: ENV.fetch("EXPORT_OPTIONS_PLIST"),
      output_directory: ipa_output_dir,
      output_name: IPA_NAME,
      clean: true,
      xcargs: xcargs.join(" ")
    )
  end

  desc "Upload the built IPA to TestFlight (internal testers only)"
  lane :beta do
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path
    UI.user_error!("No IPA at #{ipa}") unless File.exist?(ipa)

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end

  desc "Submit the latest build for App Store review (manual release gate)"
  lane :release do
    key = asc_api_key
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path

    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    deliver(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end
end
