# Xcode project is generated from project.yml by XcodeGen — never commit it.
*.xcodeproj
*.xcworkspace

# Generated entitlements (XcodeGen writes these from project.yml).
Brands/**/*.entitlements

# Build output & derived data
build/
DerivedData/
.build/

# Swift Package Manager
.swiftpm/
Package.resolved

# Local secret overrides — never commit real client ids / URLs here.
Brands/**/*.local.xcconfig

# fastlane output (report.xml/README.md are regenerated every run; certs and
# profiles land here when RUNNER_TEMP is unset) + local Vault secret files.
fastlane/report.xml
fastlane/README.md
fastlane/*.cer
fastlane/*.p12
*.mobileprovision
.ios-secrets/

# macOS
.DS_Store
