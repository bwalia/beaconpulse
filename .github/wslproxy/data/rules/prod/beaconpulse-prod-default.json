{
  "id": "beaconpulse-prod-default",
  "name": "beaconpulse-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["beaconpulse", "prod"],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "192.168.11.121:32100",
      "strip_path": false,
      "backends": [
        {
          "address": "192.168.11.121:32100",
          "weight": 100,
          "label": "k3s1 traefik ingress (wslproxy class) via operator LAN — same target the working diytax-prod-default rule uses; 13.42.188.136 was the pre-migration k3s0 IP"
        },
        {
          "address": "192.168.11.132:32100",
          "weight": 100,
          "label": "k3s1 traefik ingress (wslproxy class) — second node for HA"
        }
      ],
      "routing": {
        "mode": "least_conn"
      }
    }
  },
  "servers": [
    "host:int.beaconpulse.net",
    "host:test.beaconpulse.net",
    "host:acc.beaconpulse.net",
    "host:beaconpulse.net"
  ]
}
