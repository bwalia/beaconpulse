{
  "id": "beaconpulse-prod-default",
  "name": "beaconpulse-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["beaconpulse", "prod"],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "77.68.126.63:80",
      "strip_path": false,
      "backends": [
        {
          "address": "77.68.126.63:80",
          "weight": 100,
          "label": "cloud003 public IP — the working diytax-prod-cloud003 rule (which serves gatus/tax/api on this same wslproxy IngressClass) uses this same target. Pop1 (18.133.126.242) is on the internet and cannot reach 192.168.11.x LAN or 13.42.188.136 (dead)."
        }
      ],
      "routing": {
        "mode": "least_conn"
      }
    }
  },
  "servers": [
    "host:int.beaconpulse.net",
    "host:test.beaconpulse.net",
    "host:acc.beaconpulse.net",
    "host:beaconpulse.net"
  ]
}
