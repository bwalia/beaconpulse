{
  "id": "sysops-prod-default",
  "name": "sysops-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["sysops", "prod"],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "77.68.126.63:80",
      "strip_path": false,
      "backends": [
        {
          "address": "77.68.126.63:80",
          "weight": 100,
          "label": "cloud003 public IP — same target the working diytax-prod-cloud003 rule uses. 13.42.188.136 was the pre-migration k3s0 IP and no longer exists."
        }
      ],
      "routing": {
        "mode": "least_conn"
      }
    }
  },
  "servers": [
    "host:int.sysops247.com",
    "host:test.sysops247.com",
    "host:acc.sysops247.com",
    "host:sysops247.com"
  ]
}
