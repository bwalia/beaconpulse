{
  "id": "sysops-prod-default",
  "name": "sysops-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["sysops", "prod"],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "193.237.176.232:8888",
      "strip_path": false,
      "backends": [
        {
          "address": "193.237.176.232:8888",
          "weight": 100,
          "label": "k3s1 traefik ingress entry (klipper) — same target as aws-k3s1-ingress-klipper-80, the backend every working wslproxy host uses. traefik routes by Host. Do NOT point this at 13.42.188.136:80 (times out from the edge) or pop1.wslproxy.com (the edge itself — proxy loop)."
        }
      ],
      "routing": {
        "mode": "least_conn"
      }
    }
  },
  "servers": [
    "host:int.sysops247.com",
    "host:test.sysops247.com",
    "host:acc.sysops247.com",
    "host:sysops247.com"
  ]
}
