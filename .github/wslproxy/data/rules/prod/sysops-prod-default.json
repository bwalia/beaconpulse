{
  "id": "sysops-prod-default",
  "name": "sysops-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["sysops", "prod"],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "193.237.176.232:8888",
      "strip_path": false,
      "backends": [
        {
          "address": "193.237.176.232:8888",
          "weight": 100,
          "label": "k3s1 traefik ingress entry (klipper) — the same target aws-k3s1-ingress-klipper-80 uses for every working wslproxy host. 193.237.176.232:8888 forwards to k3s1 traefik, which routes by Host. cloud003 (77.68.126.63) was a dead-end."
        }
      ],
      "routing": {
        "mode": "least_conn"
      }
    }
  },
  "servers": [
    "host:int.sysops247.com",
    "host:test.sysops247.com",
    "host:acc.sysops247.com",
    "host:sysops247.com"
  ]
}
