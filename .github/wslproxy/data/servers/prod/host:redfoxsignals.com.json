{
  "id": "host:redfoxsignals.com",
  "server_name": "redfoxsignals.com",
  "proxy_server_name": "redfoxsignals.com",
  "root": "/var/www/html",
  "index": "index.html",
  "access_log": "logs/redfoxsignals.com.access.log",
  "error_log": "logs/redfoxsignals.com.error.log",
  "config_status": false,
  "profile_id": "prod",
  "rules": "redfox-prod-default",
  "listens": [
    {
      "listen": "80"
    }
  ],
  "ssl_enabled": true,
  "ssl_force_https": true,
  "ssl_staging": false,
  "ssl_auto_renew": true,
  "ssl_email": "admin@redfoxsignals.com",
  "cache_enabled": false,
  "match_cases": {},
  "custom_headers": []
}
