{
  "id": "host:www.uptimely.org",
  "server_name": "www.uptimely.org",
  "proxy_server_name": "www.uptimely.org",
  "root": "/var/www/html",
  "index": "index.html",
  "access_log": "logs/www.uptimely.org.access.log",
  "error_log": "logs/www.uptimely.org.error.log",
  "config_status": false,
  "profile_id": "prod",
  "rules": "uptimely-prod-default",
  "listens": [
    {
      "listen": "80"
    }
  ],
  "ssl_enabled": true,
  "ssl_force_https": true,
  "ssl_staging": false,
  "ssl_auto_renew": true,
  "ssl_email": "admin@uptimely.org",
  "cache_enabled": false,
  "match_cases": {},
  "custom_headers": []
}
